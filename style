* {
  box-sizing: border-box;
}
 
body {
  margin: 0;
  font-family: Georgia, 'Times New Roman', serif;
  color: #222;
  background-color: #fff;
  line-height: 1.6;
}
 
header {
  border-bottom: 1px solid #ddd;
  padding: 1rem 0;
}
 
nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin: 0;
  padding: 0;
}
 
nav a {
  text-decoration: none;
  color: #222;
  font-size: 0.95rem;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
 
nav a:hover {
  text-decoration: underline;
}
 
.container {
  max-width: 700px;
  margin: 3rem auto;
  padding: 0 1.5rem;
}
 
.profile {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}
 
.profile-photo {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 4px;
  flex-shrink: 0;
  filter: grayscale(100%);
}
 
.profile-text h1 {
  margin-top: 0;
  font-size: 1.8rem;
  font-weight: normal;
}
 
.profile-text p {
  margin: 0.8rem 0;
}
 
a {
  color: #1a5276;
}
 
footer {
  text-align: center;
  color: #888;
  font-size: 0.85rem;
  margin: 3rem 0 1.5rem;
}
 
@media (max-width: 500px) {
  .profile {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}
